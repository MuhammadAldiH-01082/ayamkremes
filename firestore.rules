rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'aldihidayatulloh45@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Menus: Anyone can read, only admin can write
    match /menus/{menuId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promos: Anyone can read, only admin can write
    match /promos/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Signed in users can create and read their own orders, admin can manage all
    match /orders/{orderId} {
      allow create: if isSignedIn() || request.resource.data.customerEmail is string;
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Chats: Users can read/write their own chat, admin can manage all
    match /chats/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      match /messages/{messageId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
  }
}

