rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'aldihidayatulloh45@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Menus: Anyone can read, only admin can write
    match /menus/{menuId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promos: Anyone can read, only admin can write
    match /promos/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Signed in users can create, admin can manage
    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // Chats: Users can read/write their own chat, admin can manage all
    match /chats/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      match /messages/{messageId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
  }
}
