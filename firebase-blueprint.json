{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Profil pengguna pelanggan atau admin",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "description": "Nama pengguna" },
        "email": { "type": "string", "description": "Email pengguna" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "Peran pengguna" },
        "phone": { "type": "string", "description": "Nomor WhatsApp" },
        "address": { "type": "string", "description": "Alamat pengiriman default" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Menu": {
      "title": "Catering Menu",
      "description": "Daftar menu catering Ayam Kremes Jakarta",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Nama menu" },
        "description": { "type": "string", "description": "Deskripsi menu" },
        "price": { "type": "number", "description": "Harga dasar" },
        "category": { "type": "string", "description": "Kategori menu" },
        "imageUrl": { "type": "string", "description": "URL gambar menu" },
        "isMain": { "type": "boolean", "description": "Apakah ini menu utama" },
        "spiceLevel": { "type": "number", "description": "Tingkat kepedasan" },
        "badge": { "type": "string", "description": "Label khusus" },
        "portion": { "type": "string", "description": "Porsi" },
        "minOrder": { "type": "number", "description": "Minimal order" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "price"]
    },
    "Promo": {
      "title": "Promotion",
      "description": "Promo catering",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "discountPercent": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "active"]
    },
    "Order": {
      "title": "Customer Order",
      "description": "Pesanan pelanggan katering",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerEmail": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "eventType": { "type": "string" },
        "eventDate": { "type": "string" },
        "eventTime": { "type": "string" },
        "paxCount": { "type": "number" },
        "selectedPackage": { "type": "string" },
        "notes": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Diproses", "Dikirim", "Selesai", "Dibatalkan"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "customerEmail", "status"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Pesan dalam obrolan",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "text"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Koleksi profil pengguna (user & admin)"
    },
    "menus/{menuId}": {
      "schema": "Menu",
      "description": "Koleksi menu catering"
    },
    "promos/{promoId}": {
      "schema": "Promo",
      "description": "Koleksi promo aktif"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Koleksi pesanan pelanggan"
    },
    "chats/{userId}": {
      "schema": "object",
      "description": "Ruang obrolan pengguna dengan customer service"
    },
    "chats/{userId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Koleksi pesan dalam obrolan"
    }
  }
}
